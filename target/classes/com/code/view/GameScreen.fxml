<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainRoot" stylesheets = "@../../../css/theme_style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.controller.GameController">
<BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
   
   <top>
      <HBox alignment="CENTER" spacing="50.0" style="-fx-padding: 20;">
         <VBox alignment="CENTER">
             <Label text="PLAYER 2" textFill="RED"><font><Font name="System Bold" size="14.0" /></font></Label>
             <Label fx:id="lblScoreP2" text="Score: 0" />
         </VBox>
         <Label fx:id="lblTurnInfo" text="Lượt: ..." textFill="#0026ff"><font><Font size="18.0" /></font></Label>
         <VBox alignment="CENTER">
             <Label text="PLAYER 1" textFill="BLUE"><font><Font name="System Bold" size="14.0" /></font></Label>
             <Label fx:id="lblScoreP1" text="Score: 0" />
         </VBox>
      </HBox>
   </top>

   <center>
 
      <GridPane fx:id="gridBoard" alignment="CENTER" hgap="5.0" vgap="5.0" />
   </center>

   <bottom>
      <HBox alignment="CENTER" style="-fx-padding: 20;">
         <Button fx:id="btnMenu"  stylesheets ="@../../../css/home_button_style.css"/>
      </HBox>
   </bottom>
	
	<ImageView fx:id="handCursor" fitHeight="60.0" fitWidth="60.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" visible="false" />
	
</BorderPane>

</AnchorPane>
