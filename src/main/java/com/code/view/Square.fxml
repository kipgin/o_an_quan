<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="120.0" prefWidth="100.0" stylesheets="@../../../css/square_style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.controller.SquareController">

    <!-- Container chứa sỏi (FlowPane giúp sỏi tự xuống dòng) -->
    <FlowPane fx:id="stoneContainer" alignment="CENTER" hgap="3" prefHeight="120.0" prefWidth="100.0" style="-fx-padding: 10;" vgap="3">
        <!-- Sỏi sẽ được add vào đây bằng code Java -->
    </FlowPane>
   
    <!-- Số điểm (đặt ở góc hoặc mờ bên dưới) -->
    <VBox alignment="BOTTOM_CENTER" mouseTransparent="true">
        <Label fx:id="lblStones" styleClass="score-text" text="5">
             <font><Font size="18.0" /></font>
             <VBox.margin><Insets bottom="5.0" /></VBox.margin>
        </Label>
    </VBox>
       
    
    <StackPane alignment="CENTER" pickOnBounds="false">
    
	    <!-- Mũi tên TRÁI -->
	    <!-- pickOnBounds="true" giúp click vào vùng bao quanh tam giác cũng ăn -->
	    <Polygon fx:id="arrowLeft" fill="#228b22" visible="false" 
	             points="0.0, 10.0, 10.0, 0.0, 10.0, 20.0" 
	             StackPane.alignment="CENTER_LEFT" pickOnBounds="true">
	         <StackPane.margin><Insets left="5.0"/></StackPane.margin>
<!-- 	         <cursor><Cursor fx:constant="HAND" /></cursor> -->
	    </Polygon>
	    
	    <!-- Mũi tên PHẢI -->
	    <Polygon fx:id="arrowRight" fill="#228b22" visible="false" 
	             points="0.0, 0.0, 10.0, 10.0, 0.0, 20.0" 
	             StackPane.alignment="CENTER_RIGHT" pickOnBounds="true">
	         <StackPane.margin><Insets right="5.0"/></StackPane.margin>
<!-- 	         <cursor><Cursor fx:constant="HAND" /></cursor> -->
	    </Polygon>
	    
	</StackPane>

</StackPane>
